# TradeOS configuration template. Copy to .env and fill in. NEVER commit .env (it holds secrets).

# Required: SEC fair-access policy requires a declared contact address.
SEC_USER_AGENT=TradeOS your@email.com

# Prices (Slice 4). Free key at https://tiingo.com. Backtest is skipped without it.
TIINGO_API_KEY=

# LLM explanations + screenshot ticker extraction (Slice 5). Free key at
# https://aistudio.google.com/apikey. With no key, the deterministic template is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EXPLAIN_PROVIDER=template     # 'gemini' to use the model (still behind the guards), else 'template'

# Auth (Slice 6). Set true behind TLS in production (enables Secure cookies + HSTS).
COOKIE_SECURE=false

# Billing (Slice D). Leave EMPTY for test mode: the upgrade flow works end to end with NO charge
# (self-serve test activation), clearly labeled. To go live: create a FREE Stripe account, add
# `stripe` to requirements.txt, and set the four values below (Trader/Pro recurring Price IDs +
# a webhook signing secret for the endpoint POST /api/billing/webhook). Card data never touches
# TradeOS — Stripe hosts Checkout. While a real key is set, the test-activation path is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RETAIL=
STRIPE_PRICE_PRO=

# Optional error tracking (active only when set).
# SENTRY_DSN=

# Modular inputs (build-plan 7.2 moves these into the feature_flags table).
# ENABLE_CONGRESS=false
# ENABLE_SHORT_INTEREST=false

# Admin seeding (optional; else seed-admin prompts interactively).
# TRADEOS_ADMIN_PASSWORD=
