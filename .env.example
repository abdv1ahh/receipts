# Receipts — copy to .env and fill in. Nothing here is secret; .env itself is gitignored.
# `./scripts/setup.sh` writes this file with a generated database password.
# Every variable below is read by the code. `python -m tradeos.cli preflight` checks it.

# ---- required ------------------------------------------------------------------------------
#
# TWO KEYS, AND THEY ARE THE SAME KEY. Alpaca is the only external service this product needs:
# it supplies the end-of-day closes every call is scored against, and its asset list is the
# universe of symbols anyone can publish a call on. Free, no card, no paid tier involved —
# https://app.alpaca.markets/signup, then "API Keys" in the paper-trading dashboard.
#
# Both halves are required. A key id without its secret is an anonymous client that 403s on every
# bar, and the failure looks like "no prices" rather than "bad credential".
#
# `cli check-source alpaca` makes a real request and tells you which of the two is wrong.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# REQUIRED, and there is deliberately no default: docker-compose.yml refuses to start without it,
# so a public repository cannot ship every self-hoster the same database password.
# `./scripts/setup.sh` generates one for you and writes it here.
#
# Postgres reads this only when the cluster is FIRST initialised. Changing it against an existing
# pgdata volume locks you out of your own database rather than rotating anything.
POSTGRES_PASSWORD=

# ---- how this instance is reached --------------------------------------------------------------
#
# The origin this instance is reachable at from OUTSIDE it, with no trailing slash. Every share
# card and og:url is built from it, so a wrong value means a caller's shared record previews as a
# bare link on every platform — which is the distribution model, silently off. Unset falls back to
# http://localhost:8000 for development, and `cli preflight` fails on it.
PUBLIC_BASE_URL=http://localhost:8000

# The name on the board, the rail and the share card. Yours, if you are running your own.
BRAND_NAME=Receipts

# ---- production ----------------------------------------------------------------------------
#
# Session cookies require HTTPS, and HSTS is enabled with them. Leave false for local development;
# `cli preflight` warns if it is false anywhere that looks like production.
COOKIE_SECURE=false

# ---- optional --------------------------------------------------------------------------------
#
# Outbound mail. Without it, email verification and password reset cannot send — so a forgotten
# password is unrecoverable and an account's address is never confirmed. The app refuses to send
# rather than half-working: it will not silently drop a reset link. See docs/known_gaps.md §1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Sign in with Google, instead of an email and password. Create an OAuth 2.0 Client ID of type
# "Web application" and register <PUBLIC_BASE_URL>/api/auth/google/callback exactly. Both values or
# neither: half-configured is worse than none, because the button appears and the callback fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side error tracking. Optional, and initialised with traces_sample_rate 0.0 so it reports
# errors and not performance traces.
SENTRY_DSN=
