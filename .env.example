# Rhumb — copy to .env and fill in. Nothing here is secret; .env itself is gitignored.
# Every variable below is read by the code. `python -m tradeos.cli preflight` checks the important ones.

# ---- required ------------------------------------------------------------------------------
# SEC fair-access policy requires a contact address in the User-Agent. The app refuses to run without it.
SEC_USER_AGENT=YourName you@example.com

# Postgres. docker-compose sets this for you; only override for a managed database.
DATABASE_URL=postgresql://tradeos:${POSTGRES_PASSWORD}@db:5432/tradeos

# ---- language model ------------------------------------------------------------------------
# A comma-separated FALLBACK CHAIN, tried in order, so one provider dying does not silence every
# AI surface. Valid names: gemini, openai, template (template = no model, deterministic output).
EXPLAIN_PROVIDER=gemini,openai

# Google AI Studio, free tier, no card: https://aistudio.google.com/apikey
# Model ids matter — gemini-2.0-flash has a zero free-tier allowance and gemini-2.5-* are closed
# to new keys. gemini-flash-latest and gemini-flash-lite-latest work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Any OpenAI-compatible /chat/completions endpoint. Free options:
#   OpenRouter  https://openrouter.ai/keys        base https://openrouter.ai/api/v1
#   Groq        https://console.groq.com/keys     base https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FAST=

# ---- data sources (all free tiers; every one is optional and degrades honestly) -------------
# End-of-day prices, which is how claim outcomes get scored: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
# Reddit discussion volume + sentiment. Create a free app of type "script":
#   https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube discussion volume + sentiment (small free quota):
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# CUSIP -> ticker mapping for 13F holdings. Works keyless at a low rate limit; a key raises it:
#   https://www.openfigi.com/api
OPENFIGI_API_KEY=

# ---- sign in with Google (Phase 8; optional — email + password works without it) -------------
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and register the redirect URI
#     <PUBLIC_BASE_URL>/api/auth/google/callback
# exactly, scheme and port included. Leaving these empty makes the flow refuse with a clear reason
# rather than half-working. NOTE: the live handshake has never been exercised — see tradeos/oauth.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- outbound email (verification + password reset) ------------------------------------------
# Without these the app REFUSES to send rather than half-working, and preflight flags it. Any SMTP
# provider works; a free tier (Resend, Mailgun, SES) is enough for two transactional messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# DEVELOPMENT ONLY. Writes unsendable verification/reset links to the server log so the flow can be
# exercised without a provider. That is a capability leak to anyone who can read logs — preflight
# treats this being 'true' as a production PROBLEM, not a warning.
MAIL_DEV_ECHO=false

# ---- runtime -------------------------------------------------------------------------------
# The origin this deployment is reachable at, with scheme and no trailing slash. Used to build the
# OAuth redirect URI, so it must match what is registered with Google.
PUBLIC_BASE_URL=http://localhost:8000
# Public product name. A single value so the display name changes without a refactor.
BRAND_NAME=Rhumb
# Set to true in production: session cookies require HTTPS, and HSTS is sent.
COOKIE_SECURE=false
# Where user-uploaded chart screenshots are written. docker-compose mounts a volume here.
UPLOADS_DIR=/app/uploads
# Extra origins allowed to make state-changing requests. Development only (the Vite dev server).
DEV_ORIGINS=
# Optional error reporting.
SENTRY_DSN=

# ---- seeding (only read by the seed-admin / seed-demo CLI commands) --------------------------
TRADEOS_ADMIN_PASSWORD=
TRADEOS_DEMO_EMAIL=
TRADEOS_DEMO_PASSWORD=

# ---- billing (Phase 8; empty = free launch mode, no charge) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
