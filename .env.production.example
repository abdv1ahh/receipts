# TradeOSS production environment. Copy to `.env.production`, fill in, and NEVER commit the real file.
#   cp .env.production.example .env.production   # then edit
# Validate before boot:  docker compose -f docker-compose.prod.yml --env-file .env.production \
#                          run --rm api python -m tradeos.cli preflight

# ── Required ───────────────────────────────────────────────────────────────
# Your public domain (DNS A record must point at this server). Caddy gets HTTPS automatically.
# For a quick IP-only test with no domain, use  DOMAIN=:80  (plain HTTP, no TLS).
DOMAIN=tradeos.example.com

# Strong, unique Postgres password (the DB is not exposed, but never ship the dev default 'tradeos').
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_USER=tradeos
POSTGRES_DB=tradeos

# SEC fair-access policy requires a contact address in the User-Agent. Use a real one you monitor.
SEC_USER_AGENT=TradeOSS you@example.com

# ── AI provider — pick ONE. All are FREE options; see FREE-AI.md for 2-minute setup. ──────────
# 'template' = deterministic prose only (fully functional, no key).
# 'gemini'   = Google AI Studio free tier.
# 'openai'   = ANY OpenAI-compatible endpoint — works FREE with GitHub Models (free w/ GitHub Pro),
#              Groq, or OpenRouter. Set OPENAI_BASE_URL + OPENAI_API_KEY + OPENAI_MODEL below.
EXPLAIN_PROVIDER=template

# -- if EXPLAIN_PROVIDER=gemini --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# -- if EXPLAIN_PROVIDER=openai -- (examples; see FREE-AI.md)
#   GitHub Models (free w/ GitHub Pro): base https://models.github.ai/inference  model openai/gpt-4o-mini
#   Groq (free):                        base https://api.groq.com/openai/v1       model llama-3.3-70b-versatile
#   OpenRouter (free models):           base https://openrouter.ai/api/v1         model meta-llama/llama-3.1-8b-instruct:free
OPENAI_BASE_URL=https://models.github.ai/inference
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

# ── Optional data sources ──────────────────────────────────────────────────
REDDIT_CLIENT_ID=               # free Reddit app -> lights up live discussion sentiment
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Billing (optional; empty = free launch mode, payment UI visible, no charge) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RETAIL=
STRIPE_PRICE_PRO=

# ── Bootstrap secrets (used once, by the deploy runbook) ───────────────────
TRADEOS_ADMIN_PASSWORD=         # for `cli seed-admin --email you@example.com`
