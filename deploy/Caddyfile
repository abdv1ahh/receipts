# TradeOSS reverse proxy. Caddy provisions + renews a Let's Encrypt TLS cert for $DOMAIN
# automatically (ports 80/443 must be reachable from the internet and DNS must point here).
# For a quick IP-only test with no domain, set DOMAIN=":80" in .env.production (no HTTPS).
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy api:8000
	header -Server
	request_body {
		max_size 9MB    # chart/screenshot uploads (API caps at 8MB)
	}
}
